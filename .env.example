# Seonex — environment variable template.
#
# Copy to `.env` for local development and fill in real values. `.env` is
# gitignored (see .gitignore); this file (`.env.example`) is the only
# environment file tracked in git, per docs/20_PROJECT_STRUCTURE.md §41.
#
# Categories match docs/07_TECHNICAL_ARCHITECTURE.md §58 and
# backend/app/infrastructure/config/settings.py.

# ── Application Configuration (ApplicationSettings) ─────────────────────────
# Not secret. Safe defaults are baked into settings.py; overriding here is
# optional except ENVIRONMENT, which you should set explicitly.

ENVIRONMENT=development        # development | test | staging | production
DEBUG=true
API_HOST=0.0.0.0
API_PORT=8000
REQUEST_TIMEOUT_SECONDS=30
LOG_LEVEL=INFO

# ── Secret Configuration (SecretSettings) ───────────────────────────────────
# Required. There is no hardcoded fallback for either value — the app will
# fail to start without them (by design, see settings.py's SecretSettings).

DATABASE_URL=postgresql+asyncpg://seonex:seonex@localhost:5432/seonex_dev
SECRET_KEY=change-me-to-a-long-random-value-before-any-real-use

# ── Runtime Configuration (RuntimeSettings) ─────────────────────────────────
# Placeholders. Unused until a later phase (AI runtime / background queue).

DEFAULT_MODEL_PROVIDER=
QUEUE_CONCURRENCY=1

# ── Frontend (apps/web, PHASE-0.6) ──────────────────────────────────────────
# Not part of ApplicationSettings/SecretSettings/RuntimeSettings above — this
# is a Next.js `NEXT_PUBLIC_*` build-time variable (client-exposed by Next's
# own convention, not a backend secret), consumed by
# apps/web/services/health.ts to reach the PHASE-0.4 health endpoint.

NEXT_PUBLIC_API_URL=http://localhost:8000
