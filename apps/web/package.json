{
  "name": "@seonex/web",
  "version": "0.1.0",
  "private": true,
  "description": "Seonex frontend — Next.js application shell (PHASE-0.6, Frontend Foundation). Lint/format/test tooling wired in PHASE-0.8 (Testing Foundation & CI).",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
